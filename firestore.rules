rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLanguage(lang) {
      return lang is string && lang.size() <= 20 && lang in ['kn-village', 'kn-en', 'en'];
    }

    function isValidFarmingMode(mode) {
      return mode is string && mode.size() <= 20 && mode in ['both', 'organic', 'chemical'];
    }

    function isValidSector(sector) {
      return sector is string && sector.size() <= 32 && sector in ['all', 'row-crops', 'horticulture', 'greenhouse', 'livestock', 'aquaculture'];
    }

    function isValidCropStage(stage) {
      return stage is string && stage.size() <= 32 && stage in ['sowing', 'growing', 'flowering', 'cutting-ready', 'sent-to-market'];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'preferredLanguage', 'preferredFarmingMode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'preferredLanguage', 'preferredFarmingMode', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.email == request.auth.token.email
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && isValidLanguage(data.preferredLanguage)
        && isValidFarmingMode(data.preferredFarmingMode)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatThread(data, userId, threadId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'sector', 'language', 'farmingMode', 'messages', 'updatedAtClient', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'sector', 'language', 'farmingMode', 'messages', 'updatedAtClient', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == threadId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && isValidSector(data.sector)
        && isValidLanguage(data.language)
        && isValidFarmingMode(data.farmingMode)
        && data.messages is list && data.messages.size() <= 50
        && (data.messages.size() == 0 || data.messages[0] is map)
        && data.updatedAtClient is string && data.updatedAtClient.size() >= 1 && data.updatedAtClient.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidKrishiCrop(data, userId, cropId) {
      return data.keys().hasAll(['id', 'ownerId', 'cropName', 'sowingDate', 'state', 'district', 'taluk', 'stage', 'logs', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'cropName', 'sowingDate', 'state', 'district', 'taluk', 'stage', 'logs', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == cropId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.cropName is string && data.cropName.size() >= 1 && data.cropName.size() <= 100
        && data.sowingDate is string && data.sowingDate.size() >= 8 && data.sowingDate.size() <= 20
        && data.state is string && data.state.size() >= 1 && data.state.size() <= 80
        && data.district is string && data.district.size() >= 1 && data.district.size() <= 80
        && data.taluk is string && data.taluk.size() <= 80
        && isValidCropStage(data.stage)
        && data.logs is list && data.logs.size() <= 30
        && (data.logs.size() == 0 || data.logs[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'preferredLanguage', 'preferredFarmingMode', 'updatedAt']);

      allow delete: if false;

      match /threads/{threadId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(threadId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(threadId)
          && isValidChatThread(incoming(), userId, threadId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(threadId)
          && isValidChatThread(incoming(), userId, threadId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'sector', 'language', 'farmingMode', 'messages', 'updatedAtClient', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(threadId);
      }

      match /crops/{cropId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(cropId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(cropId)
          && isValidKrishiCrop(incoming(), userId, cropId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(cropId)
          && isValidKrishiCrop(incoming(), userId, cropId)
          && existing().stage != 'sent-to-market'
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'logs', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['logs', 'updatedAt'])
          );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(cropId);
      }
    }
  }
}
